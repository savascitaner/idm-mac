{
  "manifest_version": 3,
  "name": "MDM - Mac Download Manager",
  "version": "0.8.0",
  "description": "İndirmeleri ve videoları MDM uygulamasına gönderir.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "download-page-video": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Bu sayfadaki videoyu MDM ile indir"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MDM",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
